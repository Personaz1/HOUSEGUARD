# Simulation Environment Configuration
MQTT_URL=mqtt://localhost:1883
MINIO_URL=http://localhost:9000
PROM_PUSHGATEWAY=http://localhost:9091

# Simulation Parameters
SIM_FPS=30
SIM_RESOLUTION=1920x1080
SIM_WEATHER_ENABLED=true
SIM_NOISE_ENABLED=true

# Model Paths
DETECTOR_MODEL_PATH=models/detect/rt_detr_uav.pt
TRACKER_MODEL_PATH=models/track/bytetrack_uav.pt
FUSION_MODEL_PATH=models/fusion/kalman_uav.pkl

# Data Paths
SYNTHETIC_DATA_PATH=data/synthetic
REAL_DATA_PATH=data/real
CHECKPOINTS_PATH=checkpoints

# Training Parameters
BATCH_SIZE=16
LEARNING_RATE=0.001
EPOCHS=100

# Evaluation
EVAL_INTERVAL=10
SAVE_INTERVAL=5

# Logging
LOG_LEVEL=INFO
WANDB_PROJECT=guardian-anti-drone
CLEARML_PROJECT=guardian-sim



